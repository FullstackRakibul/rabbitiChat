{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memes.schema.json",
  "title": "Ministry of Truth: meme banners",
  "description": "The small sticker banners between sections and in the footer (docs/TRUTH_PROMPT.md §3A.5). Decoration only, never on safety information. Plain text, both languages, at most 90 characters and 2 lines each. The rules for writing them (no people or victims, no politics, no fear, no quoted passages) are shown to the editor as a checklist.",
  "x-schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["memes"],
  "properties": {
    "memes": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/meme" } }
  },
  "$defs": {
    "meme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bn", "en", "mood", "placement", "style", "weight", "active"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
        "bn": { "type": "string", "minLength": 1, "maxLength": 90, "x-maxLines": 2 },
        "en": { "type": "string", "minLength": 1, "maxLength": 90, "x-maxLines": 2 },
        "mood": { "enum": ["calm", "alert", "relief"] },
        "placement": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["divider", "footer", "404", "empty", "backend-down"] }
        },
        "style": { "enum": ["ribbon", "stamp", "telescreen"] },
        "pose": { "enum": ["calm", "alert", "worried", "relieved", "reading", "sleeping", null] },
        "weight": { "type": "integer", "minimum": 1, "maximum": 10 },
        "active": { "type": "boolean" }
      }
    }
  }
}
