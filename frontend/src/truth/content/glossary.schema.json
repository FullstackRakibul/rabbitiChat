{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary.schema.json",
  "title": "Ministry of Truth: glossary (the Newspeak Dictionary)",
  "description": "Plain, correct one-line explanations of the terms the page uses (docs/TRUTH_PROMPT.md §3A.7). Only the page's nickname is themed; the entries never are. `match` lists the words that get a dotted underline in item summaries (Latin matched whole-word, ignoring case; Bangla at a word's start, so a suffix still matches).",
  "x-schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "pair": {
      "type": "object", "additionalProperties": false, "required": ["bn", "en"],
      "properties": { "bn": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "term", "def", "match"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
        "term": { "$ref": "#/$defs/pair", "x-maxLength": 40 },
        "def": { "$ref": "#/$defs/pair", "x-maxLength": 240 },
        "match": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 2, "maxLength": 30 } }
      }
    }
  }
}
