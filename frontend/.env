# Frontend environment (Vite). Only VITE_-prefixed keys are exposed to the app.
# In dev, /api is proxied to the .NET backend by vite.config.js — keep it relative
# so the browser stays same-origin. Point it at a full URL for other setups,
# e.g. VITE_API_BASE_URL=http://localhost:5274/api
VITE_API_BASE_URL=/api
