# Copy to `.env` and fill in. `.env` is git-ignored and is never copied into the
# image — docker compose reads it on the host and passes the values to the
# container as environment variables at run time.
#
#     cp .env.example .env
#
# Every value here is optional. Left blank, the feature it powers degrades
# gracefully: the search endpoints answer 503, and a model provider with no key
# is skipped at startup rather than treated as an error.

# Port the app is published on. http://localhost:8080 by default.
HOST_PORT=8080

# ---- Ollama (local models) ----
# host.docker.internal reaches an Ollama running on the host machine.
# For one on the LAN, use its address: http://192.168.1.50:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Secrets ----
# Never commit real values. If one of these has ever been committed, rotate it
# at the provider — a key in git history is compromised even after the file is
# edited, because the old commit still contains it.

# Ollama Cloud: powers web search and the hosted open models.
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com

# OpenAI-compatible providers.
OPENROUTER_API_KEY=
GROQ_API_KEY=
