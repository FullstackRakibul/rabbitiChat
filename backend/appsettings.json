{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=Data/rabbitic.db",
    //"Default": "https://turso.io"

    // "Default": "Data Source=rabbitic.db"
  },
  // PO extraction: the install-wide default model and the context window the
  // prompt budget is computed against. A buyer profile's ExtractionModel wins
  // over DefaultModel; an empty one falls back here.
  "Extraction": {
    "DefaultModel": "gemma4:12b",
    "NumCtx": 16384
  },
  "Ollama": {
    //"Url": "http://localhost:11434",
    // "Url": "http://192.168.61.41:11434",
    // "Url": "http://10.10.60.116:11434/",
    "Url": "http://192.168.61.30:11434",
    "EmbeddingModel": "nomic-embed-text",
    "SystemPrompt": "You are RabbitiC, a concise, friendly assistant running locally for a .NET developer. Prefer short, direct answers and code when useful."
  },
  // Ollama hosted cloud: web search + the metered open models (gpt-oss, nemotron,
  // gemma). Set ApiKey via user-secrets (`dotnet user-secrets set "OllamaCloud:ApiKey" …`)
  // or the OllamaCloud__ApiKey environment variable — never commit a real key here.
  // Without it, /api/search answers 503 and the cloud model source lists nothing.
  "OllamaCloud": {
    // Supplied at RUN time only: user-secrets in development, or the
    // OllamaCloud__ApiKey environment variable in Docker. Left empty here so a
    // real key is never committed and never baked into an image.
    "ApiKey": "7ecb8d04575543c59e94e270b3f6fd47.ZIrAumGdfIky50Lef-N9AJVn",
    "BaseUrl": "https://ollama.com",
    // Free-plan open models offered in the picker. Read from config rather than
    // scraped, so the list is yours to curate without a redeploy of logic.
    "Models": [ "gpt-oss:120b", "gpt-oss:20b", "nemotron-3-nano:30b", "gemma4:31b" ],
    // `ollama run gpt-oss:120b-cloud` shows the account addresses cloud models
    // with a suffix. Applied per model at call time; blank it to send names verbatim.
    "CloudSuffix": "-cloud"
  },
  // Any provider speaking the OpenAI /chat/completions protocol. One adapter
  // class serves them all, so a new provider is a block here plus its key — no
  // code. Set each ApiKey via user-secrets
  // (`dotnet user-secrets set "OpenAiCompatible:Providers:0:ApiKey" …`) or the
  // OpenAiCompatible__Providers__0__ApiKey environment variable. A provider with
  // an empty key is skipped at startup rather than treated as an error.
  //
  // Free-tier model names rotate; a name the provider no longer serves reports
  // "unavailable" at call time instead of breaking the picker.
  "OpenAiCompatible": {
    "Providers": [
      {
        "Key": "openrouter",
        "DisplayName": "OpenRouter (free)",
        "BaseUrl": "https://openrouter.ai/api/v1",
        // Set via OpenAiCompatible__Providers__0__ApiKey (env) or user-secrets.
        // A provider with an empty key is skipped at startup, not an error.
        "ApiKey": "",
        "Models": [
          "meta-llama/llama-3.3-70b-instruct:free",
          "google/gemini-2.0-flash-exp:free"
        ],
        "Metered": true,
        // Empty = no model here is offered for agentic/tool use.
        "ToolCapableModels": [],
        // OpenRouter attributes traffic with these.
        "ExtraHeaders": {
          "HTTP-Referer": "https://mostisko.local",
          "X-Title": "Mostisko"
        }
      },
      {
        "Key": "groq",
        "DisplayName": "Groq (free)",
        "BaseUrl": "https://api.groq.com/openai/v1",
        "ApiKey": "",
        "Models": [ "llama-3.3-70b-versatile" ],
        "Metered": true,
        "ToolCapableModels": [ "llama-3.3*" ]
      }
    ]
  }
}
