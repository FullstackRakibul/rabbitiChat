<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RabbitIC.Api</RootNamespace>
    <UserSecretsId>1b452343-33e8-4e83-99bd-0014a8836328</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- If a version fails to restore, run: dotnet add package <name> -->
    <PackageReference Include="AngleSharp" Version="1.8.2" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Helper\" />
  </ItemGroup>

  <!--
    The Ministry of Truth's global site text and its schema are the frontend's own
    files (docs/TRUTH_PROMPT.md §5): the share pages and the emails read the same
    text the public shell bundles, so there is one copy, never two that drift. The
    Dockerfile copies this folder next to backend/ for the same reason.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\frontend\src\truth\content\site.default.json" LogicalName="Truth.site.default.json" />
    <EmbeddedResource Include="..\frontend\src\truth\content\site.schema.json" LogicalName="Truth.site.schema.json" />
    <EmbeddedResource Include="..\frontend\src\truth\content\memes.default.json" LogicalName="Truth.memes.default.json" />
    <EmbeddedResource Include="..\frontend\src\truth\content\memes.schema.json" LogicalName="Truth.memes.schema.json" />
    <EmbeddedResource Include="..\frontend\src\truth\content\glossary.default.json" LogicalName="Truth.glossary.default.json" />
    <EmbeddedResource Include="..\frontend\src\truth\content\glossary.schema.json" LogicalName="Truth.glossary.schema.json" />
    <EmbeddedResource Include="..\frontend\src\truth\content\platforms.json" LogicalName="Truth.platforms.json" />
    <Content Update="config\truth-sources.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="config\tech-keywords.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\frontend\src\truth\content\directives.json" LogicalName="Truth.directives.json" />
  </ItemGroup>

  <!--
    Never publish developer-local configuration. appsettings.Development.json
    holds real API keys on a developer machine (it is git-ignored for that
    reason), and `dotnet publish` would otherwise copy it into the output and
    from there into a container image.

    .dockerignore already keeps it out of the Docker build context; this is the
    second lock, covering every other publish path — a manual `dotnet publish`,
    a CI artefact, an IIS deploy.
  -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.*.local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties properties_4launchsettings_1json__JsonSchema="https://json.sdmx.org/2.1/sdmx-json-structure-schema.json" /></VisualStudio></ProjectExtensions>

</Project>
